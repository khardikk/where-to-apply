---
// The whole page. Used by the home page, /c/<category> and /in/<city>, which preset the filters.
import { Image } from 'astro:assets';
import { IconBrandGithub } from '@tabler/icons-react';
import Base from '../layouts/Base.astro';
import CopyTemplate from './CopyTemplate';
import Directory from './Directory';
import GridBackground from './GridBackground.astro';
import HeroSearch from './HeroSearch';
import LinkBuilder from './LinkBuilder';
import Spotlight from './Spotlight.astro';
import ThemeToggle from './ThemeToggle';
import Tour from './Tour';
import avatar from '../assets/avatar.jpg';
import logos from '../data/logos.json';
import { CITY_PAGES } from '../data/cities';
import {
  CATEGORIES,
  CHECKED_ON,
  DM_TEMPLATE,
  NEW_FOR_DAYS,
  REFERRAL_TEMPLATE,
  SOURCES,
  TIPS,
  sourceId,
  type CategoryId,
  type Tag,
} from '../data/sources';

interface Props {
  title: string;
  description: string;
  heading: string;
  lede: string;
  crumb?: string;
  initialCat?: CategoryId | 'all';
  initialTags?: Tag[];
  initialPlace?: string;
}

const { title, description, heading, lede, crumb, initialCat = 'all', initialTags = [], initialPlace } = Astro.props;

const REPO = 'https://github.com/khardikk/where-to-apply';
const have = new Set(logos);
const items = SOURCES.map((s) => ({ ...s, id: sourceId(s), hasLogo: have.has(sourceId(s)) }));
const cutoff = Date.now() - NEW_FOR_DAYS * 86400000;
const newIds = SOURCES.filter((s) => s.added && Date.parse(s.added) >= cutoff).map(sourceId);
const checked = new Date(`${CHECKED_ON}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const people = SOURCES.filter((s) => s.x).length;

const byTag = (t: Tag) => SOURCES.filter((s) => s.tags.includes(t)).length;
const byCat = (c: CategoryId) => SOURCES.filter((s) => s.category === c).length;
const presets = [
  { label: 'India', count: byTag('India'), tag: 'India' },
  { label: 'Remote', count: byTag('Remote'), tag: 'Remote' },
  { label: 'AI', count: byTag('AI'), tag: 'AI' },
  { label: 'FDE', count: byTag('FDE'), tag: 'FDE' },
  { label: 'VC boards', count: byCat('vc'), cat: 'vc' },
  { label: 'Hiring on X', count: byCat('hiring'), cat: 'hiring' },
  { label: 'People on X', count: byCat('people'), cat: 'people' },
  { label: 'Communities', count: byCat('communities'), cat: 'communities' },
];

const steps = [
  { n: 1, title: 'Pick where to look', body: `Search or filter ${SOURCES.length} places by category, tag or city.`, href: '#directory' },
  { n: 2, title: 'Find roles first', body: 'Open ready-made searches on the job sites startups post to first.', href: '#search' },
  { n: 3, title: 'Reach out', body: 'Copy a cold DM or a referral ask and send it to a person, not a portal.', href: '#templates' },
];
---

<Base title={title} description={description}>
  <div class="fixed right-4 bottom-4 z-50">
    <ThemeToggle client:idle />
  </div>

  <header class="relative overflow-hidden border-b border-line">
    <GridBackground />
    <Spotlight />
    <div class="wrap relative pt-20 pb-14 md:pt-28 md:pb-20">
      <div class="flex flex-wrap items-center gap-2">
        <a
          href="https://hardikk.dev"
          class="inline-flex items-center gap-2 rounded-full border border-line bg-card/60 py-1 pr-3 pl-1 text-xs text-fg-2 backdrop-blur transition-colors hover:text-fg"
        >
          <Image src={avatar} alt="" width={48} height={48} class="size-6 rounded-full" loading="eager" />
          Made by Hardikk Kamboj
        </a>
        <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-line bg-card/60 px-3 py-1 text-xs text-fg-2 backdrop-blur transition-colors hover:border-line-2 hover:text-fg"
        >
          <IconBrandGithub className="size-3.5" stroke={1.8} />
          Contribute
        </a>
        <span class="num rounded-full border border-line bg-card/60 px-3 py-1 text-xs text-fg-3 backdrop-blur">Free · no sign-up</span>
      </div>

      {
        crumb && (
          <nav class="num mt-6 text-xs text-fg-3">
            <a href="/" class="hover:text-fg">
              Where to Apply
            </a>
            <span aria-hidden="true"> / </span>
            <span class="text-fg-2">{crumb}</span>
          </nav>
        )
      }

      <h1 class="mt-6 max-w-3xl text-[2.6rem] leading-[1.02] font-semibold tracking-[-0.04em] md:text-7xl">{heading}</h1>
      <p class="mt-5 max-w-2xl text-lg text-fg-2 md:text-xl">{lede}</p>

      <HeroSearch client:load total={SOURCES.length} presets={presets} />

      <dl class="num mt-8 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <div><dt class="sr-only">Sources</dt><dd><b class="text-fg text-2xl font-medium">{SOURCES.length}</b> <span class="text-fg-3">sources</span></dd></div>
        <div><dt class="sr-only">Categories</dt><dd><b class="text-fg text-2xl font-medium">{CATEGORIES.length}</b> <span class="text-fg-3">categories</span></dd></div>
        <div><dt class="sr-only">People and accounts</dt><dd><b class="text-fg text-2xl font-medium">{people}</b> <span class="text-fg-3">people and accounts on X</span></dd></div>
        <div><dt class="sr-only">Checked</dt><dd><span class="text-fg-3">every link checked</span> <b class="text-fg font-medium">{checked}</b></dd></div>
      </dl>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href="#search" class="inline-flex h-10 items-center rounded-full border border-line-2 bg-card/50 px-5 text-sm font-medium text-fg backdrop-blur transition-colors hover:bg-hover">
          Find roles first
        </a>
        <a href="#tips" class="inline-flex h-10 items-center px-2 text-sm font-medium text-fg-2 transition-colors hover:text-fg">Tips and templates</a>
        <Tour client:load />
      </div>
    </div>
  </header>

  <main class="wrap">
    <ol class="mt-10 grid gap-3 sm:grid-cols-3" aria-label="How it works">
      {
        steps.map((s) => (
          <li>
            <a href={s.href} class="group flex h-full gap-3 rounded-xl border border-line bg-card p-4 transition-colors hover:border-line-2">
              <span class="num grid size-7 shrink-0 place-items-center rounded-full border border-line-2 text-xs text-fg">{s.n}</span>
              <span>
                <span class="block text-sm font-medium text-fg">{s.title}</span>
                <span class="mt-0.5 block text-[13px] leading-snug text-fg-3">{s.body}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <section class="pt-10" aria-labelledby="directory-intro-h">
      <h2 id="directory-intro-h" class="text-xl font-semibold tracking-tight">A practical job search directory for tech roles</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-fg-2">
        Where to Apply brings together independent job boards, startup career pages, venture capital portfolio listings,
        remote platforms, hiring communities, and people who share openings. Use the list to widen your search beyond
        the largest job sites, then follow each source's own application process. The role and city search builder creates
        targeted searches for common hiring platforms, while filters help you focus on India, remote work, AI, startups,
        or forward deployed engineering. The directory is maintained as a public resource and its links are checked
        regularly. It does not promise that a source has an active opening today; always confirm role details and
        eligibility on the destination site before applying.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-fg-2">
        A useful search is usually a mix of broad and direct routes. Large boards help establish the range of roles and
        titles in the market. Startup boards and investor portfolio pages point toward smaller teams, where the company
        may publish its own application form. AI and FDE sources are included because those jobs can use titles such as
        applied AI engineer, solutions engineer, or customer engineer as well as the more familiar labels. Remote sources
        differ in the countries they can hire from, so check location restrictions before investing time in an application.
        The city pages preset the builder and list sources tagged for that location, while the category pages narrow the
        directory to a particular kind of source. These views are starting points, and they can be combined with the
        directory filters to fit a specific experience level, skill set, or search plan.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-fg-2">
        Keep a simple record of where you have looked and when you last checked each listing. The checklist stays in your
        browser, and the shared filters are represented in the page URL so you can save or send a focused view. Before
        applying, confirm that a vacancy is current, read the employer's own description, and use the official application
        link where one is provided. For a referral or a direct message, keep the note specific: name the role, explain the
        relevant work you have done, and include one useful example. The templates and tips below are intended as prompts
        to adapt, not messages to send unchanged. A thoughtful, accurate application helps both the candidate and hiring
        team make better use of their time.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-fg-2">
        Start with the location and role that fit your search, then check several source types instead of relying on one
        feed. Company career pages and portfolio boards can surface openings that are not widely reposted. Community
        groups and hiring posts can help you learn who is building a team, while remote platforms clarify whether a
        company considers applicants based in India. Use the links here as leads, compare the original listing for
        freshness, and tailor your application to the employer's stated requirements. The directory is designed to
        make discovery easier; decisions about fit, eligibility, and whether to apply remain with the job seeker.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-fg-2">
        This directory is especially useful for candidates who want to explore the Indian technology market, compare
        local and remote opportunities, or find teams working in AI and applied engineering. It includes familiar job
        sites as well as focused sources that are easy to miss, such as startup portfolios, community boards, and direct
        hiring posts. Use each listing as a lead and check the source itself for the latest role, location, and application
        details. You can return to the list, adjust a filter, and keep a browser-local checklist as your search evolves.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-fg-2">
        The directory is organized around discovery rather than application tracking or recruitment. Sources link out to
        the organizations that publish jobs, and their descriptions explain what kind of lead each one offers. Some are
        broad boards with many listings; others focus on a region, a technology, a stage of company, or a specific
        community. A source can be valuable even when it does not have a matching role today, because it may help you
        understand which teams are active and where they announce new work. The directory is updated as links are
        reviewed and new recommendations are contributed. If a listing becomes outdated or a useful source is missing,
        use the repository issue tracker to share a correction or suggestion with the maintainer.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-fg-2">
        Job titles vary between employers, particularly across AI and customer-facing engineering teams. A search for a
        single exact title can miss related work, so try adjacent terms that reflect the work you want to do. For example,
        an FDE search can be complemented with applied AI, solutions, implementation, or customer engineering terms.
        Likewise, remote does not always mean worldwide: companies may hire only in a set of countries or time zones.
        Check requirements carefully and use the search builder to open a few targeted queries, then inspect each
        employer's own listing for responsibilities, seniority, location, and application instructions.
      </p>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-fg-2">
        Browse the directory below to compare sources, open focused category or city pages, and build searches for the
        roles you want. Each link leads to the original publisher so you can verify the latest information.
      </p>
    </section>

    <section id="search" class="reveal scroll-mt-6 pt-16 md:pt-20" aria-labelledby="search-h">
      <p class="label">Link builder</p>
      <h2 id="search-h" class="mt-2 text-2xl font-semibold tracking-tight md:text-3xl">Find roles before they hit LinkedIn</h2>
      <p class="mt-2 mb-6 max-w-2xl text-fg-2">
        Pick a role and a city. Every button opens a search straight into the places companies post first.
      </p>
      <LinkBuilder client:idle initialPlace={initialPlace} />
    </section>

    <section id="directory" class="scroll-mt-0 pt-16 md:pt-20" aria-labelledby="directory-h">
      <p class="label">The list</p>
      <h2 id="directory-h" class="mt-2 text-2xl font-semibold tracking-tight md:text-3xl">{SOURCES.length} places to look</h2>
      <p class="mt-2 mb-2 max-w-2xl text-fg-2">
        Tick off what you've covered. Your checklist stays in this browser; filters live in the URL, so you can share a view.
      </p>
      <Directory client:load items={items} categories={CATEGORIES} initialCat={initialCat} initialTags={initialTags} newIds={newIds} />
    </section>

    <section id="tips" class="scroll-mt-6 pt-20 md:pt-24" aria-labelledby="tips-h">
      <p class="label">Tips</p>
      <h2 id="tips-h" class="mt-2 mb-6 text-2xl font-semibold tracking-tight md:text-3xl">What actually gets replies</h2>
      <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          TIPS.map((t, i) => (
            <li class="reveal rounded-xl border border-line bg-card p-5">
              <span class="num text-xs text-fg-3">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-2 font-medium text-fg">{t.title}</h3>
              <p class="mt-1.5 text-[13.5px] leading-relaxed text-fg-2">{t.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="templates" class="reveal scroll-mt-6 pt-16" aria-labelledby="templates-h">
      <p class="label">Templates</p>
      <h2 id="templates-h" class="mt-2 mb-6 text-2xl font-semibold tracking-tight md:text-3xl">Messages to send</h2>
      <div class="grid gap-3 md:grid-cols-2">
        <CopyTemplate client:idle title="Cold DM to a hiring manager" text={DM_TEMPLATE} />
        <CopyTemplate client:idle title="Asking for a referral" text={REFERRAL_TEMPLATE} />
      </div>
    </section>

    <section class="reveal pt-16" aria-labelledby="browse-h">
      <p id="browse-h" class="label mb-4">Browse by</p>
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <p class="mb-2 text-sm font-medium text-fg">Category</p>
          <ul class="flex flex-wrap gap-1.5">
            {
              CATEGORIES.map((c) => (
                <li>
                  <a href={`/c/${c.id}`} class="num inline-block rounded-md border border-line px-2 py-1 text-xs text-fg-2 hover:border-line-2 hover:text-fg">
                    {c.short}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="mb-2 text-sm font-medium text-fg">City</p>
          <ul class="flex flex-wrap gap-1.5">
            {
              CITY_PAGES.map((c) => (
                <li>
                  <a href={`/in/${c.slug}`} class="num inline-block rounded-md border border-line px-2 py-1 text-xs text-fg-2 hover:border-line-2 hover:text-fg">
                    {c.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <footer class="mt-20 mb-10 flex flex-col gap-4 border-t border-line pt-8 text-sm text-fg-3 sm:flex-row sm:items-center sm:justify-between">
      <p>
        Built by <a class="link" href="https://hardikk.dev">Hardikk Kamboj</a>. Missing a source?
        <a class="link" href={`${REPO}/issues/new?template=add-source.yml`} target="_blank" rel="noopener noreferrer">Suggest it</a>
        or <a class="link" href={`${REPO}/blob/main/CONTRIBUTING.md`} target="_blank" rel="noopener noreferrer">open a pull request</a>.
      </p>
      <p class="num text-xs">
        No sign-up, no affiliate links ·
        <a class="hover:text-fg" href="https://buymeacoffee.com/hardikk" target="_blank" rel="noopener noreferrer">Buy me a coffee</a>
      </p>
    </footer>
  </main>
</Base>
